{
  "name": "simtel-backend",
  "version": "1.0.0",
  "description": "Simtel Learning Platform - Backend API (Express + Prisma + PostgreSQL)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
